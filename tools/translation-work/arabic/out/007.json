 {
  "label": "SCRIPT:CHI02AudioHolder01",
  "text": "<يتحدث الحرس الأحمر>\n'أيها الجنرال، نحن كل ما تبقى من قوة الهجوم! علينا بناء مركز قيادة وتشغيل الرادار لتلقي أوامر جديدة'"
 },
 {
  "label": "SCRIPT:CHI02AudioHolder02",
  "text": "<يتحدث الحرس الأحمر>\n'أيها الجنرال، إن لم نشغّل الرادار فلن نتلقى معلومات استخباراتية عن مواقع العدو. نحتاج إلى ذلك الرادار'"
 }
