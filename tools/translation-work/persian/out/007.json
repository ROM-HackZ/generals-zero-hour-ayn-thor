 },
 {
  "label": "SCRIPT:CHI02AudioHolder01",
  "text": "<گارد سرخ صحبت می‌کند>\n'ژنرال، ما تنها بازماندگان نیروی حمله‌ایم! باید یک مرکز فرماندهی بسازیم و رادار را راه بیندازیم تا دستورهای تازه بگیریم'"
 },
 {
  "label": "SCRIPT:CHI02AudioHolder02",
  "text": "<گارد سرخ صحبت می‌کند>\n'ژنرال، اگر رادار را راه نیندازیم نمی‌توانیم از موقعیت دشمن خبر بگیریم. آن رادار را لازم داریم'"
 }
]